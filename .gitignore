# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# security - sensitive files (DO NOT commit these)
# Note: SECURITY.md, firestore.rules, firebase.json, and security code files
# should be committed as they are needed for the project to run

# Firebase service account keys (if downloaded)
*-firebase-adminsdk-*.json
serviceAccountKey.json
firebase-adminsdk-*.json

# Private keys and certificates
*.key
*.crt
*.cert
*.p12
*.pfx

# Security tokens and secrets
*.token
*.secret
secrets.json
credentials.json

# Local deployment configs (if any)
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
